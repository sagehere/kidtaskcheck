{
  "name": "kids-task-checkin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs --configLoader native",
    "build": "tsc && vite build --config vite.config.mjs --configLoader native",
    "preview": "vite preview --config vite.config.mjs --configLoader native",
    "preview:static": "node scripts/static-server.mjs",
    "test": "vitest run --config vite.config.mjs --configLoader runner",
    "server": "node server/index.mjs",
    "scheduler": "node server/scheduler.mjs",
    "deploy": "docker compose pull && docker compose up -d",
    "db:migrate:sqlite": "node scripts/sqlite-migrate.mjs",
    "db:stamp:sqlite": "node scripts/sqlite-stamp-migrations.mjs",
    "db:verify:sqlite": "node scripts/sqlite-verify.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "emoji-datasource": "^16.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
