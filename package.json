{
  "name": "kids-task-checkin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs --configLoader native",
    "build": "tsc && vite build --config vite.config.mjs --configLoader native",
    "preview": "vite preview --config vite.config.mjs --configLoader native",
    "preview:static": "node scripts/static-server.mjs",
    "test": "vitest run --config vite.config.mjs --configLoader runner",
    "pages:dev": "wrangler pages dev dist --d1=DB --port 8788 --persist-to .wrangler/state --log-level none",
    "pages:build": "npm run build && npm run db:migrate:remote",
    "deploy": "npm run pages:build",
    "deploy:pages": "npm run pages:build",
    "db:migrate:local": "wrangler d1 migrations apply kids_task_checkin --local",
    "db:migrate:remote": "wrangler d1 migrations apply kids_task_checkin --remote"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260524.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.18.0"
  }
}
